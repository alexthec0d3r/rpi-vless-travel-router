# ============================================================================
# Travel Router Configuration
# ============================================================================
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# Then run: ./configure.sh
# ============================================================================

# === WiFi Hotspot ===
WIFI_SSID="TravelRouter"
WIFI_PASSWORD="changeme123"

# === Router Access ===
# Password for SSH and LuCI web interface
ROOT_PASSWORD="changeme123"

# === VPN Server (VLESS + Reality) ===
# Works with any VLESS+Reality server. Only one server is needed.
# If you don't have a server yet, see docs/SERVER-SETUP.md
VPN_SERVER_ADDRESS=""        # IP or hostname of your VPN server
VPN_SERVER_PORT="443"        # Server port (default: 443)
VPN_UUID=""                  # VLESS UUID
VPN_REALITY_PUBLIC_KEY=""    # Reality public key from server
VPN_REALITY_SHORT_ID=""      # Reality short ID from server
VPN_REALITY_SNI=""           # SNI domain (e.g., www.google.com)

# Transport mode:
#   "tcp"   = VLESS + Vision (default, simplest)
#   "xhttp" = VLESS + XHTTP  (better for restrictive networks)
VPN_TRANSPORT="tcp"
VPN_XHTTP_PATH=""            # Only needed if VPN_TRANSPORT=xhttp (e.g., /mypath)

# === Backup Server (optional) ===
# Set VPN_BACKUP_ENABLED="true" to configure a backup server.
# The router will auto-switch to backup if primary goes down.
VPN_BACKUP_ENABLED="false"
VPN_BACKUP_ADDRESS=""
VPN_BACKUP_PORT="443"
VPN_BACKUP_UUID=""
VPN_BACKUP_REALITY_PUBLIC_KEY=""
VPN_BACKUP_REALITY_SHORT_ID=""
VPN_BACKUP_REALITY_SNI=""
VPN_BACKUP_TRANSPORT="tcp"
VPN_BACKUP_XHTTP_PATH=""

# === Russian Service Bypass (optional) ===
# "geosite" = route Russian domains/IPs direct (for users in Russia bypassing censorship)
# "none"    = all traffic through VPN (default, recommended for most users)
RUSSIAN_BYPASS="none"
